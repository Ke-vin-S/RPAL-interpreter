<project>
    <parent>
        <groupId>io.github.ke-vin-s</groupId>
        <artifactId>rpal-interpreter</artifactId>
        <version>0.1.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>rpal-cli</artifactId>
    <packaging>jar</packaging>
    <name>RPAL Command Line Interface</name>

    <dependencies>
        <dependency>
            <groupId>io.github.ke-vin-s</groupId>
            <artifactId>rpal-core</artifactId>
            <version>0.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.ke_vin_s.rpal.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
